{
  "name": "@toreador/mcp-server",
  "version": "0.3.1",
  "mcpName": "io.toreador/mcp-server",
  "description": "Official Model Context Protocol (MCP) server for Toreador: create crypto checkouts paid in stablecoins, track payments, list wallets and supported networks from Claude Desktop, Cursor and other MCP clients. Non-custodial: funds go wallet-to-wallet, Toreador never holds them.",
  "license": "MIT",
  "author": "Toreador <dev@toreador.io>",
  "homepage": "https://toreador.io/mcp",
  "bugs": {
    "url": "https://github.com/Logitale/toreador-mcp-server/issues",
    "email": "dev@toreador.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Logitale/toreador-mcp-server.git"
  },
  "keywords": [
    "toreador",
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-desktop",
    "cursor",
    "crypto",
    "crypto-payments",
    "stablecoin",
    "usdc",
    "checkout",
    "non-custodial",
    "qr-code"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "toreador-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
